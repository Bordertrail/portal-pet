{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Portal Pet",
  "identifier": "org.portalpet.chat.desktop",
  "version": "0.1.7",
  "build": {
    "frontendDist": "../interface/dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
